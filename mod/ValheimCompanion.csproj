<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>ValheimCompanion</AssemblyName>
    <RootNamespace>ValheimCompanion</RootNamespace>
    <LangVersion>10</LangVersion>
    <Nullable>disable</Nullable>
    <DebugType>portable</DebugType>
    <!-- Game/BepInEx assemblies are already present at runtime; don't copy them to the output. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep in step with the Jotunn version installed from Thunderstore. -->
    <PackageReference Include="JotunnLib" Version="2.30.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Referenced by JotunnLib's props but not shipped with current Valheim builds. -->
    <Reference Remove="UnityEngine.ProfilerModule" />
    <!-- Ships with Valheim (client and dedicated server) in valheim_Data/Managed. -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(VALHEIM_INSTALL)\valheim_Data\Managed\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Copy the plugin into BepInEx/plugins of the client and the local dedicated server. -->
  <Target Name="DeployPlugin" AfterTargets="Build">
    <ItemGroup>
      <_PluginFiles Include="$(TargetDir)$(TargetName).dll;$(TargetDir)$(TargetName).pdb" />
      <_DeployRoot Include="$(VALHEIM_INSTALL)" Condition="Exists('$(VALHEIM_INSTALL)\BepInEx')" />
      <_DeployRoot Include="$(VALHEIM_SERVER_INSTALL)" Condition="'$(VALHEIM_SERVER_INSTALL)' != '' And Exists('$(VALHEIM_SERVER_INSTALL)\BepInEx')" />
    </ItemGroup>
    <Copy SourceFiles="@(_PluginFiles)" DestinationFolder="%(_DeployRoot.Identity)\BepInEx\plugins\$(AssemblyName)" Condition="'@(_DeployRoot)' != ''" />
    <!-- Voice clips (mod/sounds) go in a sounds folder next to the DLL. -->
    <ItemGroup>
      <_SoundFiles Include="$(MSBuildProjectDirectory)\sounds\*.ogg;$(MSBuildProjectDirectory)\sounds\*.wav;$(MSBuildProjectDirectory)\sounds\captions.json" />
    </ItemGroup>
    <RemoveDir Directories="%(_DeployRoot.Identity)\BepInEx\plugins\$(AssemblyName)\sounds" Condition="'@(_DeployRoot)' != ''" />
    <ItemGroup>
      <_BlueprintFiles Include="$(MSBuildProjectDirectory)\blueprints\*.blueprint" />
    </ItemGroup>
    <Copy SourceFiles="@(_BlueprintFiles)" DestinationFolder="%(_DeployRoot.Identity)\BepInEx\plugins\$(AssemblyName)\blueprints" Condition="'@(_DeployRoot)' != '' And '@(_BlueprintFiles)' != ''" />
    <Copy SourceFiles="@(_SoundFiles)" DestinationFolder="%(_DeployRoot.Identity)\BepInEx\plugins\$(AssemblyName)\sounds" Condition="'@(_DeployRoot)' != '' And '@(_SoundFiles)' != ''" />
    <Message Importance="high" Text="Deployed $(AssemblyName) to %(_DeployRoot.Identity)\BepInEx\plugins" Condition="'@(_DeployRoot)' != ''" />
    <Warning Text="No BepInEx install found to deploy to; check mod/Environment.props" Condition="'@(_DeployRoot)' == ''" />
  </Target>

  <!-- Release builds also produce the Thunderstore upload: bin/thunderstore/Sapienheim-<version>.zip.
       The version comes from Plugin.PluginVersion, so bump it there (and add a CHANGELOG entry) before a release. -->
  <Target Name="ThunderstorePackage" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <_PluginSource>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\src\Plugin.cs'))</_PluginSource>
      <_PackageVersion>$([System.Text.RegularExpressions.Regex]::Match($(_PluginSource), 'PluginVersion = "(\d+\.\d+\.\d+)"').Groups[1].Value)</_PackageVersion>
      <_StageDir>$(BaseIntermediateOutputPath)thunderstore\</_StageDir>
      <_PackageZip>$(MSBuildProjectDirectory)\bin\thunderstore\Sapienheim-$(_PackageVersion).zip</_PackageZip>
      <_Manifest>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\thunderstore\manifest.json').Replace('{VERSION}', $(_PackageVersion)))</_Manifest>
    </PropertyGroup>
    <Error Text="Couldn't read PluginVersion (x.y.z) from src/Plugin.cs" Condition="'$(_PackageVersion)' == ''" />
    <RemoveDir Directories="$(_StageDir)" />
    <Copy SourceFiles="thunderstore\icon.png;thunderstore\README.md;thunderstore\CHANGELOG.md;$(TargetDir)$(TargetName).dll" DestinationFolder="$(_StageDir)" />
    <ItemGroup>
      <_PackageSounds Include="$(MSBuildProjectDirectory)\sounds\*.ogg;$(MSBuildProjectDirectory)\sounds\*.wav;$(MSBuildProjectDirectory)\sounds\captions.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_PackageSounds)" DestinationFolder="$(_StageDir)sounds" Condition="'@(_PackageSounds)' != ''" />
    <ItemGroup>
      <_PackageBlueprints Include="$(MSBuildProjectDirectory)\blueprints\*.blueprint" />
    </ItemGroup>
    <Copy SourceFiles="@(_PackageBlueprints)" DestinationFolder="$(_StageDir)blueprints" Condition="'@(_PackageBlueprints)' != ''" />
    <!-- ASCII: no UTF-8 byte-order mark, which JSON parsers can reject; Escape keeps any ; in the text intact. -->
    <WriteLinesToFile File="$(_StageDir)manifest.json" Lines="$([MSBuild]::Escape($(_Manifest)))" Overwrite="true" Encoding="us-ascii" />
    <MakeDir Directories="$(MSBuildProjectDirectory)\bin\thunderstore" />
    <ZipDirectory SourceDirectory="$(_StageDir)" DestinationFile="$(_PackageZip)" Overwrite="true" />
    <Message Importance="high" Text="Thunderstore package: $(_PackageZip)" />
  </Target>
</Project>
